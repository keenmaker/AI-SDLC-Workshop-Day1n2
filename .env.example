# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
# The app accepts both JWT_SECRET (required by deployment docs) and the
# legacy SESSION_SECRET name for local compatibility.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# WebAuthn relying party configuration.
# Deployment docs use RP_NAME / RP_ORIGIN; local development also supports
# NEXT_PUBLIC_RP_NAME / ORIGIN for compatibility.
RP_NAME=Todo App
NEXT_PUBLIC_RP_NAME=Todo App
RP_ID=localhost
RP_ORIGIN=http://localhost:3000
ORIGIN=http://localhost:3000

# Optional: override the SQLite file location.
DATABASE_PATH=todos.db
